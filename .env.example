# 本地运维配置示例。
# 复制为根目录 .env 后填写；.env 已被 .gitignore 忽略，绝不提交。
# 这个文件只供本机升级/部署脚本使用，不会被应用运行时自动读取。
# 生产数据库密码、JWT、TOTP 密钥仍保存在服务器自己的 deploy/.env，
# 不要复制到本仓库。

# --- 服务器 ---
SERVER=
DOMAIN=
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASS=

# --- 部署路径与 Docker 网络 ---
DEPLOY_DIR=/root/sub2api-deploy
NETWORK=sub2api-deploy_sub2api-network
SOURCE_DIR=/root/sub2api-mg-src
BACKUP_ROOT=/root/backups

# --- Canary ---
CANARY_DB=sub2api_canary
CANARY_SUFFIX=canary
CANARY_PORT=18082

# --- 镜像仓库 ---
IMAGE_REPO=ghcr.io/ericzhouyihe/sub2api-codex-guard

# --- 仅本机执行 canary 命令时临时使用（不要提交） ---
POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
